rules_version = '2';

// Reglas de seguridad de Firestore para "Finanzas García Naranjo".
//
// Solo dejan leer y escribir a quien haya iniciado sesión con Google
// usando uno de los correos de la lista de abajo. Nadie más puede ver
// ni tocar los datos, aunque conozca la URL del proyecto.
function esFamiliaAutorizada() {
  return request.auth != null &&
    request.auth.token.email in [
      'jgarciaarteaga.md@gmail.com',
      'drjuanpablogarcia@gmail.com',
      'drasaranaranjo@gmail.com'
    ];
}

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if esFamiliaAutorizada();
    }
  }
}
